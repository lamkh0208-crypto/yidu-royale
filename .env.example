GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# 豆包需要火山方舟的推論接入點 ID 當作模型名稱
DOUBAO_API_KEY=
DOUBAO_MODEL=
